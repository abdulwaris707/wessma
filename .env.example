# Public site URL (used for canonical URLs, sitemap, Open Graph, and email links)
NEXT_PUBLIC_SITE_URL=https://wessmaa.com

# Cal.com or Calendly link used on /book and discovery buttons
NEXT_PUBLIC_BOOKING_URL=https://cal.com/wessmaa/discovery-call

# -----------------------------------------------------------------------------
# 1. Neon PostgreSQL Database
# -----------------------------------------------------------------------------
# Neon connection string. Keep this strictly server-side; never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/neondb?channel_binding=require&sslmode=require

# -----------------------------------------------------------------------------
# 2. Admin Authentication
# -----------------------------------------------------------------------------
# First administrator email address:
ADMIN_EMAIL=admin@wessmaa.com

# Scrypt password hash for the administrator account. Generate with:
# node scripts/hash-password.mjs "your-secure-admin-password"
ADMIN_PASSWORD_HASH=scrypt:<salt-base64>:<hash-base64>

# Session signature secret (at least 32 characters). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# AUTH_SECRET is also supported as an alias:
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# -----------------------------------------------------------------------------
# 3. Official Company Email Sending (Choose EITHER Resend OR SMTP)
# -----------------------------------------------------------------------------
# The verified sender email address visible to clients and candidates:
EMAIL_FROM="Wessmaa <hello@wessmaa.com>"

# Option A: Resend API (Recommended for modern cloud delivery)
RESEND_API_KEY=re_1234567890abcdef

# Option B: Standard SMTP (Google Workspace, Microsoft 365, Hostinger, AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@wessmaa.com
SMTP_PASSWORD=your-smtp-app-password

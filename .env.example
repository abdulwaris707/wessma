# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://wessmaa.com
# Optional endpoint for non-contact forms (quote, application and newsletter).
NEXT_PUBLIC_FORMS_ENDPOINT=
# Cal.com or Calendly link used on /book
NEXT_PUBLIC_BOOKING_URL=https://cal.com/wessmaa/discovery-call

# Neon connection string. Keep this server-side; never use NEXT_PUBLIC_ for it.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require

# First administrator credentials. Generate the password hash with:
# node scripts/hash-password.mjs "choose-a-long-unique-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt:<salt-base64>:<hash-base64>
# Generate a 32+ byte random value, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-long-random-secret
